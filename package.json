{
  "name": "coople-jobs",
  "private": true,
  "version": "0.0.0",
  "description": "Coople public jobs: Expo (React Native web) app with a Fastify BFF",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --names api,app --prefix-colors blue,green \"npm run dev -w @coople-jobs/api\" \"npm run web -w @coople-jobs/mobile\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
